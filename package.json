{
  "name": "streamify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "test:integration": "node --import tsx --test --experimental-test-isolation=none tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "events:prune": "node --env-file=.env --import tsx scripts/prune.ts"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "jose": "6.2.12",
    "set-cookie-parser": "3.1.2"
  }
}
