# Copy to .env. Replace secrets before use (openssl rand -hex 32).
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://streamify_app:replace-app-db-password@localhost:5432/streamify
MIGRATION_DATABASE_URL=postgresql://streamify_owner:replace-owner-db-password@localhost:5432/streamify
POSTGRES_PASSWORD=replace-owner-db-password
APP_DATABASE_PASSWORD=replace-app-db-password
REDIS_URL=redis://localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Streamify <learning@example.com>
# Set true only behind the supplied proxy, which overwrites this header.
TRUST_PROXY=false

# Production only: APP_HOST=learn.example.com; APP_ORIGIN=https://learn.example.com
# Use SMTP_SECURE=true with implicit TLS, normally SMTP_PORT=465.
